# Juniper MX204 Network Engineering Demonstration
# Sanitized, representative configuration using documentation prefixes and lab ASNs.
# Real-world production-grade design concepts; not a raw backup or deployable template.
# Reference design: aggregated Ethernet, VLAN L3 units, logical systems,
# logical-tunnel interconnect, eBGP/iBGP, routing policy, static routes, policers.

# 1. SYSTEM IDENTITY, ACCESS, TIME, LOGGING
set system host-name EDGE-LAB-MX204
set system domain-name lab.example
set system time-zone Asia/Dhaka
set system services ssh protocol-version v2
set system services ssh root-login deny
set system services ssh connection-limit 10
set system services ssh rate-limit 5
set system services netconf ssh
set system syslog user * any emergency
set system syslog file messages any notice
set system syslog file messages authorization info
set system syslog file interactive-commands interactive-commands info
set system login class netops-view permissions view
set system login class netops-view permissions view-configuration
set system login class netops-view allow-commands "show|ping|traceroute"
# Add account only after supplying a valid public key:
# set system login user netops-demo class netops-view
# set system login user netops-demo authentication ssh-ed25519 "REPLACE_WITH_PUBLIC_KEY"

# 2. CHASSIS AND AGGREGATED ETHERNET
set chassis aggregated-devices ethernet device-count 1
set interfaces et-0/0/0 description "LAB-LAG-MEMBER-1"
set interfaces et-0/0/0 ether-options 802.3ad ae0
set interfaces et-0/0/1 description "LAB-LAG-MEMBER-2"
set interfaces et-0/0/1 ether-options 802.3ad ae0
set interfaces ae0 description "LAB-SERVICE-TRUNK"
set interfaces ae0 flexible-vlan-tagging
set interfaces ae0 encapsulation flexible-ethernet-services
set interfaces ae0 aggregated-ether-options lacp active
set interfaces ae0 aggregated-ether-options minimum-links 1

# 3. MASTER ROUTING CONTEXT INTERFACES
set interfaces lo0 unit 0 family inet address 192.0.2.1/32
set interfaces et-0/0/2 description "LAB-MASTER-TRANSIT"
set interfaces et-0/0/2 unit 0 family inet address 198.51.100.1/30

# 4. MASTER ROUTING OPTIONS AND STATIC ROUTES
set routing-options router-id 192.0.2.1
set routing-options autonomous-system 65010
set routing-options static route 203.0.113.0/24 discard
set routing-options static route 192.0.2.20/32 next-hop 10.255.0.2

# 5. MASTER ROUTING POLICIES
set policy-options prefix-list LAB-OWN-PREFIXES 203.0.113.0/24
set policy-options policy-statement TRANSIT-IN term ACCEPT-DEFAULT from route-filter 0.0.0.0/0 exact
set policy-options policy-statement TRANSIT-IN term ACCEPT-DEFAULT then local-preference 200
set policy-options policy-statement TRANSIT-IN term ACCEPT-DEFAULT then accept
set policy-options policy-statement TRANSIT-IN term REJECT-REST then reject
set policy-options policy-statement TRANSIT-OUT term OWN-PREFIX from prefix-list LAB-OWN-PREFIXES
set policy-options policy-statement TRANSIT-OUT term OWN-PREFIX then accept
set policy-options policy-statement TRANSIT-OUT term REJECT-REST then reject

# 6. MASTER eBGP TRANSIT PEERING
set protocols bgp group TRANSIT-LAB type external
set protocols bgp group TRANSIT-LAB description "DOCUMENTATION-TRANSIT-PEER"
set protocols bgp group TRANSIT-LAB peer-as 65030
set protocols bgp group TRANSIT-LAB neighbor 198.51.100.2 import TRANSIT-IN
set protocols bgp group TRANSIT-LAB neighbor 198.51.100.2 export TRANSIT-OUT
set protocols bgp group TRANSIT-LAB hold-time 30

# 7. MASTER <-> CDN-LS iBGP
set protocols bgp group CDN-LS-IBGP type internal
set protocols bgp group CDN-LS-IBGP local-address 192.0.2.1
set protocols bgp group CDN-LS-IBGP neighbor 192.0.2.20

# Optional OSPF underlay example. Enable only with a matching topology.
# set protocols ospf area 0.0.0.0 interface lo0.0 passive
# set protocols ospf area 0.0.0.0 interface et-0/0/3.0 interface-type p2p

# 8. INTERNAL LOGICAL-TUNNEL LINK TO CDN-LS
set interfaces lt-0/0/0 unit 500 description "MASTER-TO-CDN-LS"
set interfaces lt-0/0/0 unit 500 encapsulation ethernet
set interfaces lt-0/0/0 unit 500 peer-unit 501
set interfaces lt-0/0/0 unit 500 family inet address 10.255.0.1/30

# 9. LOGICAL SYSTEM CDN-LS
set logical-systems CDN-LS interfaces lt-0/0/0 unit 501 description "CDN-LS-TO-MASTER"
set logical-systems CDN-LS interfaces lt-0/0/0 unit 501 encapsulation ethernet
set logical-systems CDN-LS interfaces lt-0/0/0 unit 501 peer-unit 500
set logical-systems CDN-LS interfaces lt-0/0/0 unit 501 family inet address 10.255.0.2/30
set logical-systems CDN-LS interfaces lo0 unit 20 description "CDN-LS-LOOPBACK"
set logical-systems CDN-LS interfaces lo0 unit 20 family inet address 192.0.2.20/32

# VLAN 100: service handoff, peer address 192.0.2.6/30
set logical-systems CDN-LS interfaces ae0 unit 100 description "LAB-SERVICE-EDGE"
set logical-systems CDN-LS interfaces ae0 unit 100 vlan-id 100
set logical-systems CDN-LS interfaces ae0 unit 100 family inet address 192.0.2.5/30

# VLAN 200: cache service handoff
set logical-systems CDN-LS interfaces ae0 unit 200 description "LAB-CACHE-SERVICE"
set logical-systems CDN-LS interfaces ae0 unit 200 vlan-id 200
set logical-systems CDN-LS interfaces ae0 unit 200 family inet address 192.0.2.9/30

# VLAN 300: transit handoff, peer address 198.51.100.6/30
set logical-systems CDN-LS interfaces ae0 unit 300 description "LAB-TRANSIT"
set logical-systems CDN-LS interfaces ae0 unit 300 vlan-id 300
set logical-systems CDN-LS interfaces ae0 unit 300 family inet address 198.51.100.5/30

# 10. CDN-LS ROUTING OPTIONS
# Same AS 65010 as master because the inter-context BGP group is iBGP.
set logical-systems CDN-LS routing-options router-id 192.0.2.20
set logical-systems CDN-LS routing-options autonomous-system 65010
set logical-systems CDN-LS routing-options static route 203.0.113.64/26 discard
set logical-systems CDN-LS routing-options static route 192.0.2.1/32 next-hop 10.255.0.1

# 11. CDN-LS PREFIX FILTERS AND BGP POLICIES
set logical-systems CDN-LS policy-options prefix-list CDN-LAB-PREFIXES 203.0.113.64/26
set logical-systems CDN-LS policy-options policy-statement CDN-TRANSIT-IN term DEFAULT-ONLY from route-filter 0.0.0.0/0 exact
set logical-systems CDN-LS policy-options policy-statement CDN-TRANSIT-IN term DEFAULT-ONLY then local-preference 250
set logical-systems CDN-LS policy-options policy-statement CDN-TRANSIT-IN term DEFAULT-ONLY then accept
set logical-systems CDN-LS policy-options policy-statement CDN-TRANSIT-IN term DENY-REST then reject
set logical-systems CDN-LS policy-options policy-statement CDN-TRANSIT-OUT term OWN-PREFIX from prefix-list CDN-LAB-PREFIXES
set logical-systems CDN-LS policy-options policy-statement CDN-TRANSIT-OUT term OWN-PREFIX then accept
set logical-systems CDN-LS policy-options policy-statement CDN-TRANSIT-OUT term DENY-REST then reject
set logical-systems CDN-LS policy-options policy-statement CUSTOMER-IN term CUSTOMER-PREFIX from route-filter 203.0.113.128/26 exact
set logical-systems CDN-LS policy-options policy-statement CUSTOMER-IN term CUSTOMER-PREFIX then accept
set logical-systems CDN-LS policy-options policy-statement CUSTOMER-IN term DENY-REST then reject
set logical-systems CDN-LS policy-options policy-statement CUSTOMER-OUT term SERVICE-PREFIX from prefix-list CDN-LAB-PREFIXES
set logical-systems CDN-LS policy-options policy-statement CUSTOMER-OUT term SERVICE-PREFIX then next-hop self
set logical-systems CDN-LS policy-options policy-statement CUSTOMER-OUT term SERVICE-PREFIX then accept
set logical-systems CDN-LS policy-options policy-statement CUSTOMER-OUT term DENY-REST then reject

# 12. CDN-LS eBGP PEER GROUPS
set logical-systems CDN-LS protocols bgp group CDN-TRANSIT type external
set logical-systems CDN-LS protocols bgp group CDN-TRANSIT description "LAB-UPSTREAM"
set logical-systems CDN-LS protocols bgp group CDN-TRANSIT peer-as 65040
set logical-systems CDN-LS protocols bgp group CDN-TRANSIT neighbor 198.51.100.6 import CDN-TRANSIT-IN
set logical-systems CDN-LS protocols bgp group CDN-TRANSIT neighbor 198.51.100.6 export CDN-TRANSIT-OUT
set logical-systems CDN-LS protocols bgp group CDN-TRANSIT hold-time 30

set logical-systems CDN-LS protocols bgp group CDN-CUSTOMER type external
set logical-systems CDN-LS protocols bgp group CDN-CUSTOMER description "LAB-EDGE-PEERING"
set logical-systems CDN-LS protocols bgp group CDN-CUSTOMER peer-as 65050
set logical-systems CDN-LS protocols bgp group CDN-CUSTOMER neighbor 192.0.2.6 import CUSTOMER-IN
set logical-systems CDN-LS protocols bgp group CDN-CUSTOMER neighbor 192.0.2.6 export CUSTOMER-OUT

# iBGP to master routing context, using the paired logical-tunnel path.
set logical-systems CDN-LS protocols bgp group MASTER-IBGP type internal
set logical-systems CDN-LS protocols bgp group MASTER-IBGP local-address 192.0.2.20
set logical-systems CDN-LS protocols bgp group MASTER-IBGP neighbor 192.0.2.1

# 13. CDN-LS BANDWIDTH POLICERS
set logical-systems CDN-LS firewall policer SERVICE-100M if-exceeding bandwidth-limit 100m
set logical-systems CDN-LS firewall policer SERVICE-100M if-exceeding burst-size-limit 1m
set logical-systems CDN-LS firewall policer SERVICE-100M then discard
set logical-systems CDN-LS firewall policer CACHE-250M if-exceeding bandwidth-limit 250m
set logical-systems CDN-LS firewall policer CACHE-250M if-exceeding burst-size-limit 1m
set logical-systems CDN-LS firewall policer CACHE-250M then discard
set logical-systems CDN-LS interfaces ae0 unit 100 family inet policer input SERVICE-100M
set logical-systems CDN-LS interfaces ae0 unit 100 family inet policer output SERVICE-100M
set logical-systems CDN-LS interfaces ae0 unit 200 family inet policer input CACHE-250M
set logical-systems CDN-LS interfaces ae0 unit 200 family inet policer output CACHE-250M

# 14. PBR
# Not activated in this baseline. PBR needs a forwarding routing-instance,
# a firewall filter attached at the intended ingress point, and next-hop design.

# END OF DEMONSTRATION CONFIGURATION
