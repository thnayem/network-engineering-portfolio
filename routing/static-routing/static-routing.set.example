# Juniper Junos static routing example
# Documentation-only addresses. Validate routing-instance and next-hop context.

set routing-options static route 203.0.113.0/24 discard
set routing-options static route 203.0.113.128/25 next-hop 198.51.100.2
set routing-options static route 192.0.2.0/24 reject

# Optional qualified next-hop example for controlled preference:
set routing-options static route 198.51.100.128/25 next-hop 198.51.100.6
set routing-options static route 198.51.100.128/25 preference 10
