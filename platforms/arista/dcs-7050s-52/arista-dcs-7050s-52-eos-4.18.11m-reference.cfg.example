interface Ethernet35
   description TRUNK-PORT-35
   switchport mode trunk
!
interface Ethernet36
   description TRUNK-PORT-36
   switchport mode trunk
!
interface Ethernet37
   description TRUNK-PORT-37
   switchport mode trunk
!
interface Ethernet38
   description TRUNK-PORT-38
   switchport mode trunk
!
interface Ethernet39
   description TRUNK-PORT-39
   switchport mode trunk
!
interface Ethernet40
   description TRUNK-PORT-40
   switchport mode trunk
!
interface Ethernet41
   description TRUNK-PORT-41
   switchport mode trunk
!
interface Ethernet42
   description TRUNK-PORT-42
   switchport mode trunk
!
interface Ethernet43
   description TRUNK-PORT-43
   switchport mode trunk
!
interface Ethernet44
   description TRUNK-PORT-44
   switchport mode trunk
!
interface Ethernet45
   description TRUNK-PORT-45
   switchport mode trunk
!
interface Ethernet46
   description TRUNK-PORT-46
   switchport mode trunk
