set [ find default-name=ether4 ] comment=IX-TV l2mtu=1592
set [ find default-name=sfp-sfpplus1 ] advertise="10M-half,10M-full,100M-half,\
    100M-full,1000M-half,1000M-full,2500M-full,5000M-full,10000M-full" speed=\
    1Gbps
set [ find default-name=sfp1 ] auto-negotiation=no
