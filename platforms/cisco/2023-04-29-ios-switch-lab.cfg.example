! Reference archive date: 2023-04-29
! Independently authored fictional lab. Not a production configuration.

vlan 10
 name USERS
vlan 20
 name VOICE
vlan 99
 name MANAGEMENT

spanning-tree mode rapid-pvst
spanning-tree vlan 10,20,99 priority 4096

interface GigabitEthernet1/0/1
 description LAB-USER-PORT
 switchport mode access
 switchport access vlan 10
 spanning-tree portfast
 spanning-tree bpduguard enable

interface GigabitEthernet1/0/48
 description LAB-UPLINK
 switchport mode trunk
 switchport trunk allowed vlan 10,20,99

! OSPF lab example
router ospf 10
 router-id 10.255.0.1
 network 192.0.2.0 0.0.0.3 area 0

! BGP and PBR examples are maintained in the dedicated topic folders.
