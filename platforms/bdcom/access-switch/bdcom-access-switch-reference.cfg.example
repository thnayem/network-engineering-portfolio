! Sanitized BDCOM access/distribution switch reference
! Source software: 2.1.1B build 28530
! Source device: 28-port Gigabit Ethernet BDCOM switch (exact model not identified)
! Curated example; not a complete production backup.
! Hostname, port descriptions, credentials, management IPs and SNMP community removed/replaced.

service timestamps log date
service timestamps debug date
hostname BDCOM-ACCESS-SW

spanning-tree mode rstp
spanning-tree rstp priority 4096

aaa authentication login default local
aaa authentication enable default none
aaa authorization exec default local
! Local user credential intentionally omitted.

interface Port-aggregator1
 switchport mode trunk

interface Null0

interface GigaEthernet0/1
 switchport trunk vlan-allowed 1225
 switchport trunk vlan-untagged 1225
 switchport pvid 1225
 speed 100

interface GigaEthernet0/2
 switchport trunk vlan-allowed 1226
 switchport trunk vlan-untagged 1226
 switchport pvid 1226
 speed 100

