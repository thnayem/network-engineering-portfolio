interface GigaEthernet0/18
 description CUSTOMER-TRUNK-A
 switchport trunk vlan-allowed 109,209,309,409
 switchport mode trunk
 speed 1000

interface GigaEthernet0/19
 switchport trunk vlan-allowed 1243
 switchport trunk vlan-untagged 1243
 switchport pvid 1243
 speed 100

interface GigaEthernet0/20
 switchport trunk vlan-allowed 1244
 switchport trunk vlan-untagged 1244
 switchport pvid 1244
 speed 100

interface GigaEthernet0/21
 speed 100

interface GigaEthernet0/22
 description CUSTOMER-TRUNK-B
 spanning-tree guard root
 switchport mode trunk
 speed 100

interface GigaEthernet0/23
 description CUSTOMER-TRUNK-C
 spanning-tree guard root
 switchport mode trunk
 speed 1000

interface GigaEthernet0/24
 description CUSTOMER-TRUNK-D
 switchport trunk vlan-allowed 1400-1424
 switchport mode trunk
 speed 1000

interface GigaEthernet0/25
!
interface GigaEthernet0/26
!
interface GigaEthernet0/27
 aggregator-group 1 mode static
 switchport mode trunk

interface GigaEthernet0/28
 aggregator-group 1 mode static
 switchport mode trunk

interface VLAN1
 ip address 192.0.2.1 255.255.255.0
 no ip directed-broadcast

interface VLAN1255
 ip address 198.51.100.2 255.255.255.252
 no ip directed-broadcast

vlan 1,101-109,801-804,1101-1124,1201-1255,1301-1326,1400-1424,1501-1524,1601-1624,1631
vlan 1632-1643,2101-2128,3799,3998,4002,4005

no ip igmp-proxy enable

ip route default 198.51.100.1
ip exf
ipv6 exf

ip http language english
! HTTP server omitted from public example.
! SNMP community omitted; configure a unique secure community in a lab.
ip sshd enable
