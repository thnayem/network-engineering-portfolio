    transmit-hash-policy=layer-2-and-3
/interface ethernet switch port
set 0 default-vlan-id=0 vlan-mode=fallback
set 1 default-vlan-id=0 vlan-mode=fallback
set 2 default-vlan-id=0 vlan-mode=fallback
set 3 default-vlan-id=0 vlan-mode=fallback
set 4 default-vlan-id=0 vlan-mode=fallback
/port
set 0 name=serial0
set 1 name=serial1
/queue type
add kind=pcq name=BDIX pcq-classifier=src-address,dst-address pcq-rate=1G
/queue simple
add disabled=yes dst=vlan401-BDIX-PEER-01 name=test queue=BDIX/BDIX target=\
    ""
/routing bgp instance
set default as=64520 client-to-client-reflection=no redistribute-connected=\
