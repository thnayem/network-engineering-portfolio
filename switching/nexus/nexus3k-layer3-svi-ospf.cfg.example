! Cisco Nexus 3000 Series - Layer 3 SVI and OSPF reference
! Requires a Nexus 3K model and NX-OS image supporting these features.
! Documentation-only IPs and ASN.

feature interface-vlan
feature ospf
ip routing

vlan 10
  name USERS
vlan 30
  name SERVERS
vlan 99
  name MANAGEMENT

interface Vlan10
  description LAB-USERS-GATEWAY
  no shutdown
  ip address 192.0.2.1/24
  ip router ospf LAB-UNDERLAY area 0.0.0.0

interface Vlan30
  description LAB-SERVERS-GATEWAY
  no shutdown
  ip address 198.51.100.1/24
  ip router ospf LAB-UNDERLAY area 0.0.0.0

interface Ethernet1/51
  description LAB-ROUTED-UPLINK
  no switchport
  ip address 203.0.113.2/30
  no shutdown
  ip router ospf LAB-UNDERLAY area 0.0.0.0

router ospf LAB-UNDERLAY
  router-id 192.0.2.254
  passive-interface default
  no passive-interface Ethernet1/51

! Verification:
! show ip interface brief
! show ip ospf neighbors
! show ip route ospf
! show ip ospf interface brief
