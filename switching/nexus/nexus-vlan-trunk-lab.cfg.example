! Cisco Nexus NX-OS-style VLAN and trunk example
! Independently authored lab configuration.

feature interface-vlan

vlan 10
  name USERS
vlan 20
  name VOICE
vlan 99
  name MANAGEMENT

interface Ethernet1/1
  description LAB-ACCESS-PORT
  switchport
  switchport mode access
  switchport access vlan 10

interface Ethernet1/48
  description LAB-TRUNK-UPLINK
  switchport
  switchport mode trunk
  switchport trunk allowed vlan 10,20,99

! Verify exact syntax and feature requirements on the target Nexus platform.
