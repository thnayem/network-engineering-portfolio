! Cisco Nexus 3000 source-derived reference
! Source NX-OS 7.0(3)I4(6), timestamp 2024-06-18
! Source hardware profile: 48x10G + 4x40G; exact PID not stated.
! Reduced and sanitized. VLANs and descriptions are documentation-only.
version 7.0(3)I4(6)
hostname N3K-CORE-MST-REF
feature interface-vlan
feature lacp
feature lldp
no password strength-check
no ip domain-lookup
spanning-tree mode mst
spanning-tree mst 0 priority 0
service unsupported-transceiver

spanning-tree mst configuration
  name PORTFOLIO-MST
  revision 1
  instance 1 vlan 47-52,56-63
  instance 2 vlan 93-120,201-220

vlan 47-52
vlan 56-63
vlan 93-120
vlan 201-220
vlan 301-320
vlan 400-420
vlan 895-900
vlan 1101-1105
vlan 1534-1538
vlan 1699
vlan 1734-1739
vlan 1834-1839
vlan 2072-2073
vlan 2105
vlan 2156
  name IX-SERVICE
vlan 2185
vlan 2259-2260
vlan 2326
vlan 2478
vlan 2507
vlan 2650-2652
vlan 3202
vlan 3206
vlan 3535
vlan 3564-3566
vlan 3571
vlan 3853
vlan 3880-3883
vlan 3900

vrf context management
  ip route 0.0.0.0/0 192.0.2.1

interface Vlan1
  shutdown
interface Vlan99
  no shutdown
  ip address 192.0.2.2/30

! Core-router LACP trunk
interface port-channel3
  description CORE-ROUTER-LACP
  switchport
  switchport mode trunk
  switchport trunk allowed vlan 1-56,58-4094

! Aggregation LACP trunks - sanitized allow-lists
interface port-channel2
  description ACCESS-AGGREGATION-LACP
  switchport
  switchport mode trunk
  switchport trunk allowed vlan 47-52,56-63,93-98,100,102,105-108,110,112-114,116,120,202-208,210,212-214,216,220,302-308,310,312-314,316,320,402,405-408,410,412-414,416,420,502,505-508,510,512-514,520,1101-1105,1699,3853,3881,3883

